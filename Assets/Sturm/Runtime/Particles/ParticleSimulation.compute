// Particle simulation kernels for ParticleEffect.
//
// Slots form a ring buffer. Each frame Emit overwrites the next _EmitCount
// slots after _EmitHead, so the oldest particles are recycled first and no
// free list or atomic counter is needed. An undersized buffer cuts old
// particles short instead of dropping new ones.

#pragma kernel Clear
#pragma kernel Emit
#pragma kernel Update

#include "ParticleCommon.hlsl"
#include "Noise.hlsl"

RWStructuredBuffer<Particle> _Particles;
uint _Capacity;

// Emission

uint _EmitHead;
uint _EmitCount;
uint _EmitTries;
uint _Seed;

float4x4 _EmitterMatrix;
float2 _EmitterSize;
float _EmitterThickness;
float _RimBias;

float2 _Lifetime;           // x: base, y: randomness
float3 _InitialVelocity;
float _InitialSpread;
float _NormalSpeed;

// r: matte, gb: outward silhouette normal in the image plane, a: rimness
Texture2D<float4> _EmissionMap;
// rgb: linear source color, a: matte
Texture2D<float4> _ColorMap;
SamplerState linear_clamp_sampler;

// Dynamics

float _DeltaTime;
float _DragFactor;
float3 _Gravity;
float _NoiseFrequency;
float _NoiseAmplitude;
uint _NoiseOctaves;
float3 _NoiseOffset1;
float3 _NoiseOffset2;

float _StrayRatio;
float _StraySpeed;
float3 _StrayAxis;          // World direction toward the viewer

[numthreads(256, 1, 1)]
void Clear(uint id : SV_DispatchThreadID)
{
    if (id >= _Capacity) return;
    _Particles[id] = (Particle)0;
}

// Rejection sampling over the image plane. Each try draws a uniform point
// and keeps it with the emission density there, so particles appear in
// proportion to the density without building a CDF. A try budget bounds the
// cost; when every try misses (nobody in frame, or a very thin rim) the slot
// stays dead and the effective rate drops, which reads naturally on stage.
[numthreads(64, 1, 1)]
void Emit(uint id : SV_DispatchThreadID)
{
    if (id >= _EmitCount) return;

    uint index = (_EmitHead + id) % _Capacity;
    uint seed = PcgHash(PcgHash(_Seed) ^ id);

    Particle p = (Particle)0;

    for (uint i = 0; i < _EmitTries; i++)
    {
        float2 uv = float2(NextRandom(seed), NextRandom(seed));
        float4 e = _EmissionMap.SampleLevel(linear_clamp_sampler, uv, 0);
        float density = e.r * lerp(1, e.a, _RimBias);
        if (NextRandom(seed) >= density) continue;

        float3 local = float3((uv - 0.5) * _EmitterSize,
                              (NextRandom(seed) - 0.5) * _EmitterThickness);

        // Pushing along the outward normal makes the body shed particles
        // through its outline rather than straight toward the viewer.
        float3 v = _InitialVelocity;
        v += RandomUnitVector(seed) * _InitialSpread;
        v += float3(e.gb, 0) * (_NormalSpeed * e.a);

        p.position = mul(_EmitterMatrix, float4(local, 1)).xyz;
        p.velocity = mul((float3x3)_EmitterMatrix, v);
        p.age = 0;
        p.life = max(_Lifetime.x * (1 - _Lifetime.y * NextRandom(seed)), 1e-3);
        // The camera color is kept raw. The renderer decides per effect how
        // it shows through (tint, brightness or added light).
        p.color = _ColorMap.SampleLevel(linear_clamp_sampler, uv, 0).rgb;
        p.random = NextRandom(seed);
        break;
    }

    _Particles[index] = p;
}

// Strays leave the flow along the view axis, three in four toward the
// camera. The drift is kinematic and rides on top of the flow, which keeps its speed
// independent of the drag setting and leaves the stray's local swirl intact.
// It eases in over the first half second so strays peel off the body rather
// than shoot out of it.
float3 StrayDrift(Particle p)
{
    uint seed = PcgHash(asuint(p.random) ^ 0x5bd1e995u);
    float side = NextRandom(seed) < 0.75 ? 1 : -1;
    float speed = _StraySpeed * (0.5 + NextRandom(seed));
    float3 dir = normalize(_StrayAxis * side + RandomUnitVector(seed) * 0.4);
    return dir * speed * saturate(p.age * 2);
}

// Semi-implicit Euler with exponential drag. The noise acts as a force, so
// drag sets how tightly particles follow the flow: high drag makes them
// trace the streamlines like smoke, low drag lets momentum carry them
// across eddies like sparks.
[numthreads(256, 1, 1)]
void Update(uint id : SV_DispatchThreadID)
{
    if (id >= _Capacity) return;

    Particle p = _Particles[id];
    if (!IsAlive(p)) return;

    float3 flow = DivergenceFreeNoise(p.position * _NoiseFrequency,
                                      _NoiseOffset1, _NoiseOffset2,
                                      _NoiseOctaves);

    p.velocity += (flow * _NoiseAmplitude + _Gravity) * _DeltaTime;
    p.velocity *= _DragFactor;
    p.position += p.velocity * _DeltaTime;
    if (IsStray(p, _StrayRatio)) p.position += StrayDrift(p) * _DeltaTime;
    p.age += _DeltaTime;

    _Particles[id] = p;
}

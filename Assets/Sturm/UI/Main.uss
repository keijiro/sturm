:root {
    flex-grow: 1;
    --surface: rgba(29, 29, 29, 0.8);
    --border: #3c3c3c;
    --text: #ededed;
    --accent: #cccccc;
}

/* The overlay sits on top of the stage output, so it must stay transparent
   and let clicks through everywhere except the controls themselves. */
.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    color: var(--text);
}

.controls {
    position: absolute;
    left: 20px;
    bottom: 20px;
    flex-direction: row;
    align-items: center;
}

.dropdown-control {
    height: 36px;
    margin-right: 12px;
}

.source-control {
    width: 300px;
}

.effect-control {
    width: 200px;
}

.dropdown {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    min-width: 0;
}

.dropdown > .unity-base-popup-field__input {
    flex-grow: 1;
    min-width: 0;
    min-height: 36px;
    margin: 0;
    padding: 0 38px 0 14px;
    flex-direction: row;
    align-items: center;
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--border);
    border-radius: 3px;
}

.dropdown:hover > .unity-base-popup-field__input {
    background-color: #2a2a2a;
    border-color: #707070;
}

.dropdown:focus > .unity-base-popup-field__input {
    border-color: var(--accent);
}

.dropdown:disabled > .unity-base-popup-field__input {
    opacity: 0.45;
}

.dropdown .unity-base-popup-field__text {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    color: var(--text);
    font-size: 13px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.dropdown .unity-base-popup-field__arrow {
    display: none;
}

.dropdown-icon {
    position: absolute;
    top: 0;
    right: 14px;
    bottom: 0;
    width: 12px;
    margin: 0;
    padding: 0;
    color: var(--accent);
    font-size: 16px;
    -unity-text-align: middle-center;
}

.status {
    margin: 0 0 0 4px;
    padding: 0;
    color: var(--accent);
    font-size: 12px;
    white-space: nowrap;
    -unity-text-align: middle-left;
}
